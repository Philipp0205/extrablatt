# Railway (and similar PaaS) terminate TLS at the edge and forward plain HTTP
# to whatever port the container publishes via $PORT — so, unlike
# deploy/Caddyfile, this listens on a bare port instead of a domain name and
# does not request its own certificate.
:{$PORT}

encode gzip
root * /srv/marketing
file_server

header {
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
	X-Frame-Options DENY
	-Server
}

# The page and its stylesheet only make sense as a pair, so the HTML is
# revalidated on every visit while the versioned asset URLs carry the caching.
# Without this, a browser can keep last week's CSS and render the new markup
# with it.
@page path / /*.html
header @page Cache-Control "no-cache"
header /assets/* Cache-Control "public, max-age=604800"
