# Railway (and similar PaaS) terminate TLS at the edge and forward plain HTTP
# to whatever port the container publishes via $PORT — so, unlike
# deploy/Caddyfile, this listens on a bare port instead of a domain name and
# does not request its own certificate.
:{$PORT}

encode gzip
root * /srv/marketing
file_server

header {
	X-Content-Type-Options nosniff
	Referrer-Policy no-referrer
	X-Frame-Options DENY
	-Server
}
