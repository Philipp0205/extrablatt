# The application itself (registration, feeds, reading, Send-to-Kindle).
# Point this at your app subdomain, e.g. reader.extrablatt.app.
{$DOMAIN:localhost} {
	encode gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

# Static marketing/landing page, served straight from disk — no application
# server involved. Point this at your bare domain, e.g. extrablatt.app.
# Left pointing at a placeholder host when MARKETING_DOMAIN is unset, so Caddy
# still starts up cleanly on a single-domain (app-only) deployment.
{$MARKETING_DOMAIN:marketing.localhost} {
	encode gzip
	root * /srv/marketing
	file_server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# The page and its stylesheet only make sense as a pair, so the HTML is
	# revalidated on every visit while the versioned asset URLs carry the
	# caching. Without this, a browser can keep last week's CSS and render
	# the new markup with it.
	@page path / /*.html
	header @page Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=604800"
}
