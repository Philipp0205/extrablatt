# Copy to .env and fill in. Never commit .env.

# Public hostname the application itself runs under, for Caddy TLS
# (self-host / VPS deploy only). This is the app subdomain, not the marketing
# site — e.g. reader.extrablatt.app if the landing page lives at extrablatt.app.
DOMAIN=reader.rss.example.com

# Optional: hostname for the static marketing/landing page (deploy/../marketing),
# served by the same bundled Caddy container as a separate site block. Leave
# unset/blank to skip it and run the app only.
MARKETING_DOMAIN=rss.example.com

# Public base URL, used to build links in verification / password-reset e-mails.
# On Railway this is your service URL, e.g. https://kindle-rss.up.railway.app
APP_PUBLIC_URL=https://reader.rss.example.com

# Loopback port the app publishes when the host already runs its own proxy
# (see deploy/docker-compose.host-proxy.yml). Ignored by the bundled Caddy setup.
# APP_HTTP_PORT=8090

# Signs remember-me cookies. Use a long random value.
REMEMBER_ME_KEY=change-me-another-long-random
# Comma-separated accounts allowed to view telemetry and manage user send limits.
ADMIN_EMAILS=admin@yourdomain.com

# Outbound e-mail (shared sender for account e-mail AND Send-to-Kindle).
# Defaults target Resend: username is the literal word "resend" and the password
# is a Resend API key (starts with re_). MAIL_FROM must be on your verified domain.
MAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_AUTH=true
SMTP_STARTTLS=true

# Per-account guardrails for open registration
# MAX_FEEDS_PER_USER=50
# MAX_SENDS_PER_DAY=50

# Newsletters (optional): lets users subscribe to newsletters, which arrive by
# e-mail and get sent to Kindle the same way as any other article. Requires an
# inbound e-mail provider (Postmark, Mailgun routes, …) with MX records pointed
# at it for NEWSLETTER_INBOUND_DOMAIN, and its webhook pointed at
# https://<your-app>/inbound/newsletters?secret=<NEWSLETTER_INBOUND_SECRET>.
# Leave both unset to hide the "Add newsletter" option entirely.
# NEWSLETTER_INBOUND_DOMAIN=news.yourdomain.com
# NEWSLETTER_INBOUND_SECRET=change-me-long-random

# PayPal.me (or similar) link shown in Settings and in the occasional
# "help keep the servers running" reminder shown every 10th article sent.
# DONATE_URL=https://paypal.me/yourhandle

# Postgres (internal only for self-host; on Railway use the provided DATABASE_URL)
POSTGRES_DB=kindle_rss
POSTGRES_USER=kindle
POSTGRES_PASSWORD=change-me-db-password

# Reading
# Entries a refresh asks each feed for (0 fetches feed URLs exactly as entered)
# FEED_MAX_ENTRIES=100
# Articles per page of the article list (5–100)
# ARTICLE_PAGE_SIZE=50

# Optional local/dev JDBC overrides
# DATABASE_URL=jdbc:postgresql://localhost:5432/kindle_rss
# DATABASE_USER=kindle
# DATABASE_PASSWORD=kindle
# PORT=8080
