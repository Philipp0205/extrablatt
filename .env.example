# Copy to .env and fill in. Never commit .env.

# Public hostname for Caddy TLS
DOMAIN=rss.example.com

# Loopback port the app publishes when the host already runs its own proxy
# (see deploy/docker-compose.host-proxy.yml). Ignored by the bundled Caddy setup.
# APP_HTTP_PORT=8090

# App auth (username is always "kindle")
APP_PASSWORD=change-me-long-random
REMEMBER_ME_KEY=change-me-another-long-random

# Send-to-Kindle
KINDLE_EMAIL=yourname@kindle.com
MAIL_FROM=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Postgres (internal only)
POSTGRES_DB=kindle_rss
POSTGRES_USER=kindle
POSTGRES_PASSWORD=change-me-db-password

# Optional local/dev JDBC overrides
# DATABASE_URL=jdbc:postgresql://localhost:5432/kindle_rss
# DATABASE_USER=kindle
# DATABASE_PASSWORD=kindle
# PORT=8080
